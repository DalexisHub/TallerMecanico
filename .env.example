# Los tres procesos deben recibir los mismos valores Jwt__*.
Jwt__Clave=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_32_BYTES_O_MAS
Jwt__Emisor=TallerMecanico
Jwt__Audiencia=TallerMecanico.Clientes
Jwt__Minutos=60

# Solo TallerMecanico.Api en Render: conexión Npgsql al host pooled de Neon.
Database__Provider=PostgreSQL
ConnectionStrings__TallerMecanico="Host=REEMPLAZAR_HOST_POOLER_NEON;Port=5432;Database=tallermecanico;Username=REEMPLAZAR_USUARIO;Password=REEMPLAZAR_PASSWORD;SSL Mode=VerifyFull"
# En desarrollo local, use Database__Provider=SqlServer y conserve el User Secret SQL Server existente.
# Si corresponde, obtener una licencia válida de AutoMapper y configurarla solo en la API.
# AUTOMAPPER_LICENSE_KEY=REEMPLAZAR_CON_LICENCIA_VALIDA

# Solo GatewayApi en producción; host sin esquema ni puerto.
Downstream__TallerMecanico__Host=REEMPLAZAR_HOST_TALLER
Downstream__Repuestos__Host=REEMPLAZAR_HOST_REPUESTOS
Gateway__BaseUrl=https://REEMPLAZAR_HOST_GATEWAY

# Render proporciona PORT (normalmente 10000); el contenedor usa 8080 si falta.
PORT=10000
ASPNETCORE_ENVIRONMENT=Production
